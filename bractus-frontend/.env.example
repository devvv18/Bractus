# Bractus Frontend - Environment Variables Template
# Copy this file to .env.local and fill in the values.

# The email address where "Schedule a call" requests will be sent.
NEXT_PUBLIC_CONTACT_EMAIL=your-email@example.com
NEXT_PUBLIC_PHONE=+1 (000) 000-0000
NEXT_PUBLIC_LOCATION=City, Country

# OpenRouter Configuration (Used for the ChatBot)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
